RETRIEVAL_TOP_K=5
CHROMA_BATCH_SIZE=1000
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
INTENT_CONFIDENCE_THRESHOLD=0.45
OLLAMA_TIMEOUT_SECONDS=60
MAX_EXAMPLES=10000
